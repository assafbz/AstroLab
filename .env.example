# Copy to .env and fill in. Secrets never live in the repo (ARCHITECTURE.md §9).

# --- AI-provider boundary (ARCHITECTURE.md §5; ADR-0003) ---
# The adapter is selected by these two values; the model is a config value, not code.
AI_PROVIDER=openrouter
AI_MODEL=

# --- API auth (ARCHITECTURE.md §9) ---
# Single-tenant MVP: one bearer token, over HTTPS, sent as `Authorization: Bearer <API_TOKEN>`
# (docs/API.md, F4). Name is pinned by the contract so F1 and F4 can't drift apart.
API_TOKEN=

# --- Store (ARCHITECTURE.md §9; ADR-0001) ---
# One SQLite file; API and worker both open it (WAL + busy_timeout).
DB_PATH=./data/astrolab.sqlite

# --- Dev ports ---
API_PORT=8080
CLIENT_PORT=5173

# --- CI evidence only (ARCHITECTURE.md §5, §11; issue EV6) ---
# OpenRouter's own ZDR-classified endpoint list — the provider's path, not ours.
ZDR_ENDPOINTS_URL=https://openrouter.ai/api/v1/endpoints/zdr

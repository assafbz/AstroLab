# AstroLab web — the one origin (`docs/ARCHITECTURE.md` §1). Serves the built client and proxies `/v1`
# to the API on the same host, which is what the client's relative `fetch("/v1/…")` assumes
# (`client/vite.config.ts`). TLS is not Caddy's job here: the host is reached through Tailscale, which
# terminates HTTPS for the tailnet name (`docs/DEPLOY.md`, "access").
{
	admin off
	auto_https off
}

:8080 {
	encode zstd gzip

	# The API namespace, classified the way the API classifies it: **any path whose first segment begins
	# `/v1`** (`api/src/server.ts`, `looksLikeV1`, over the decode-then-collapse `normalizePath`). The
	# naive `path /v1/*` is not that test — it misses `/v1` and `/v1x/…`, which the API gates, so those
	# fell through to the static handler instead of the API's `401`.
	# The prefix is never rewritten (no URI in the upstream, no `rewrite`), so a matched request reaches
	# the API byte-verbatim. Matching tests the *cleaned* path, though: `path_regexp` resolves `.`/`..`,
	# which the API's normaliser does not, so a spelling that cleans out of the namespace
	# (`/v1/../ideas` → `/ideas`) is refused by the static handler (`404`) instead of the API (`401`) —
	# either way no route is reached (`docs/DEPLOY.md`, "The proxy is a pass-through").
	@api path_regexp ^/v1

	# The event stream must reach the client unbuffered, or the deck updates on a timer instead of on
	# the event (`GET /v1/sparks/events`; `docs/ARCHITECTURE.md` §4). `flush_interval -1` writes each
	# event through as it arrives; the transport is HTTP/1.1 with no read timeout, so a quiet stream is
	# not torn down between heartbeats.
	@events path /v1/sparks/events
	handle @events {
		reverse_proxy api:8080 {
			flush_interval -1
			transport http {
				versions 1.1
				read_timeout 0
			}
		}
	}

	handle @api {
		reverse_proxy api:8080
	}

	# `/healthz` answers before the auth gate and needs no token (`api/src/server.ts`), so one URL
	# answers for the whole stack — the container healthcheck and an operator check use the same one.
	# It stays outside the API namespace, so no access gate may ever wrap it (`docs/DEPLOY.md`).
	handle /healthz {
		reverse_proxy api:8080
	}

	# Everything else is the client's static bundle. **No SPA fallback**: the client routes on the
	# fragment (`#/capture/…`, `#/sparks/…` — `client/src/`), so no page lives at a path. An unknown
	# path is a real `404` rather than a silent `200` index.html, which would otherwise hand back the
	# bundled bearer for any typo'd URL.
	handle {
		root * /srv
		file_server
	}
}

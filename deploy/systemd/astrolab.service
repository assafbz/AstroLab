[Unit]
Description=AstroLab (api · worker · web)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/astrolab
# The same entry point the deploy path calls, with no image argument: bring up whatever is recorded in
# image.env. A host reboot therefore restarts exactly the image that was last deployed.
ExecStart=/opt/astrolab/deploy.sh
ExecStop=/usr/bin/docker compose -f /opt/astrolab/docker-compose.yml down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target

{
  "name": "astrolab",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "api",
    "worker",
    "client",
    "store",
    "core"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -n api,worker -c blue,magenta \"npm:dev:api\" \"npm:dev:worker\"",
    "dev:api": "npm run dev --workspace api",
    "dev:worker": "npm run dev --workspace worker",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "lint:citations": "node scripts/lint-citations.mjs",
    "audit:zdr": "tsx scripts/audit-zdr.ts",
    "format": "prettier --check .",
    "format:write": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.7.0",
    "concurrently": "^9.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.11.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true
  }
}
